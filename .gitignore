__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
.DS_Store

# inbox/ holds raw incoming submissions and the processed archive -- local
# working state for scripts/process_inbox.py, not repo content. The actual
# record of what got accepted is baselines/*.py + baselines/registry.json,
# which are tracked normally. Keep the format doc tracked so a fresh clone
# has it.
inbox/*
!inbox/README.md

# scripts/update_leaderboard.py's per-baseline score cache -- local build
# state, safely regenerable from scratch (see that script's docstring for
# the invalidation scheme), not repo content.
.leaderboard_cache.json

# scripts/update_leaderboard_ancillas.py's own analogue -- same reasoning,
# separate file (gated by harness_v2_fingerprint(), not harness_fingerprint()).
.leaderboard_cache_ancillas.json
